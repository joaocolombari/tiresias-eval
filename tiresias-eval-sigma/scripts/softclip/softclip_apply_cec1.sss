// #LANGUAGE# C#
// Apply the CEC1/openMHA-compatible output soft clip to the ADAU1787 Sigma core.
// Generated against tiresias-eval export at commit 5773309.
// Stop the REW stimulus before running this script.

string icName = "IC 1";
string stage = "pre-flight";
int tableAddress = 0x2860;
int holdAddress = 0x2914;
int decayAddress = 0x2918;
int tableWords = 45;

byte[] headroomExpected = new byte[] { 0x00, 0x0A, 0x2A, 0xDB }; // -22 dB at 0x285C
byte[] holdExpected = new byte[] { 0x00, 0x00, 0x00, 0x00 };     // 0 ms
byte[] decayExpected = new byte[] { 0x00, 0x00, 0x01, 0x3D };    // exported project value

// Each word is a linear gain in 5.23 format. Detector levels are
// -90, -87, ..., +42 dBFS. The requested transfer is:
//   y = x                                  for x <= -27.036 dBFS
//   y = -27.036 + 0.2 * (x + 27.036)       until y reaches -22 dBFS
//   y = -22                                above that point
byte[][] targetWords = new byte[][] {
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x80, 0x00, 0x00 },
    new byte[] { 0x00, 0x7F, 0x93, 0x88 },
    new byte[] { 0x00, 0x60, 0xC6, 0xCA },
    new byte[] { 0x00, 0x49, 0x69, 0x99 },
    new byte[] { 0x00, 0x37, 0xB0, 0x67 },
    new byte[] { 0x00, 0x2A, 0x3E, 0x96 },
    new byte[] { 0x00, 0x20, 0x0B, 0xB4 },
    new byte[] { 0x00, 0x18, 0x4F, 0x25 },
    new byte[] { 0x00, 0x12, 0x70, 0xBD },
    new byte[] { 0x00, 0x0D, 0xFD, 0x0C },
    new byte[] { 0x00, 0x0A, 0x2A, 0xDB },
    new byte[] { 0x00, 0x07, 0x32, 0xAE },
    new byte[] { 0x00, 0x05, 0x18, 0x84 },
    new byte[] { 0x00, 0x03, 0x9B, 0x87 },
    new byte[] { 0x00, 0x02, 0x8D, 0xCF },
    new byte[] { 0x00, 0x01, 0xCE, 0xDC },
    new byte[] { 0x00, 0x01, 0x47, 0xAE },
    new byte[] { 0x00, 0x00, 0xE7, 0xFB },
    new byte[] { 0x00, 0x00, 0xA4, 0x3B },
    new byte[] { 0x00, 0x00, 0x74, 0x44 },
    new byte[] { 0x00, 0x00, 0x52, 0x4F },
    new byte[] { 0x00, 0x00, 0x3A, 0x45 },
    new byte[] { 0x00, 0x00, 0x29, 0x41 },
    new byte[] { 0x00, 0x00, 0x1D, 0x34 },
    new byte[] { 0x00, 0x00, 0x14, 0xAD }
};

try
{
    if (targetWords.Length != tableWords)
        throw new System.Exception("Internal table length mismatch");

    byte[] actual = new byte[4];
    ss.ICRegisterRead(icName, 0x285C, 4, ref actual);
    for (int k = 0; k < 4; k++)
        if (actual[k] != headroomExpected[k])
            throw new System.OperationCanceledException(
                "output_headroom is not -22 dB at 0x285C");

    actual = new byte[4];
    ss.ICRegisterRead(icName, holdAddress, 4, ref actual);
    for (int k = 0; k < 4; k++)
        if (actual[k] != holdExpected[k])
            throw new System.OperationCanceledException("Unexpected SoftClip hold value");

    actual = new byte[4];
    ss.ICRegisterRead(icName, decayAddress, 4, ref actual);
    for (int k = 0; k < 4; k++)
        if (actual[k] != decayExpected[k])
            throw new System.OperationCanceledException("Unexpected SoftClip decay value");

    for (int wordIndex = 0; wordIndex < tableWords; wordIndex++)
    {
        int address = tableAddress + 4 * wordIndex;
        stage = System.String.Format("write SoftClip word {0} at 0x{1:X4}", wordIndex, address);
        ss.ICRegisterWrite(icName, address, 4, targetWords[wordIndex]);

        actual = new byte[4];
        ss.ICRegisterRead(icName, address, 4, ref actual);
        for (int k = 0; k < 4; k++)
            if (actual[k] != targetWords[wordIndex][k])
                throw new System.Exception(
                    System.String.Format("SoftClip readback mismatch at 0x{0:X4}", address + k));
    }

    System.Windows.Forms.MessageBox.Show(
        "PASS: CEC1 SoftClip LUT loaded and verified.\n\n" +
        "Threshold: -27.036 dBFS\n" +
        "Compression slope: 0.2\n" +
        "Output ceiling: -22 dBFS\n" +
        "Hold/decay were verified and left unchanged.");
}
catch (System.OperationCanceledException ex)
{
    System.Windows.Forms.MessageBox.Show(
        "ABORT during: " + stage + "\n\n" + ex.Message +
        "\n\nRun Link Compile Download and campaign_apply_output_headroom.sss, then retry.");
}
catch (System.Exception ex)
{
    System.Windows.Forms.MessageBox.Show(
        "ERROR during: " + stage + "\n\n" + ex.ToString() +
        "\n\nRun softclip_restore_transparent.sss or Link Compile Download before measuring.");
}
