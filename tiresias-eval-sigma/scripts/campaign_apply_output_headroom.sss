// #LANGUAGE# C#
// Apply -22 dB using the SigmaDSP output_headroom gain block.
// DAC_VOL0/1 are intentionally not read or modified.

string icName = "IC 1";
int address = 0x2924;
byte[] unityValue = new byte[] { 0x00, 0x80, 0x00, 0x00 };
byte[] campaignValue = new byte[] { 0x00, 0x0A, 0x2A, 0xDB };
string stage = "pre-flight";

try
{
    byte[] actual = new byte[4];
    ss.ICRegisterRead(icName, address, 4, ref actual);
    bool isUnity = true;
    bool isCampaign = true;
    for (int k = 0; k < 4; k++)
    {
        if (actual[k] != unityValue[k]) isUnity = false;
        if (actual[k] != campaignValue[k]) isCampaign = false;
    }
    if (!isUnity && !isCampaign)
        throw new System.OperationCanceledException(
            System.String.Format(
                "Unexpected output_headroom value at 0x{0:X4}", address));

    stage = "write output_headroom";
    ss.ICRegisterWrite(icName, address, 4, campaignValue);
    actual = new byte[4];
    ss.ICRegisterRead(icName, address, 4, ref actual);
    for (int k = 0; k < 4; k++)
        if (actual[k] != campaignValue[k])
            throw new System.Exception(
                System.String.Format(
                    "Readback mismatch at 0x{0:X4}", address + k));

    System.Windows.Forms.MessageBox.Show(
        "PASS: output_headroom set to -22 dB at 0x2924.\n\n" +
        "DAC_VOL0/1 were not changed.\n" +
        "Keep this setting unchanged for unity and all prescription sweeps.");
}
catch (System.OperationCanceledException ex)
{
    System.Windows.Forms.MessageBox.Show(
        "ABORT during: " + stage + "\n\n" + ex.Message +
        "\n\nRun Link Compile Download and try again.");
}
catch (System.Exception ex)
{
    System.Windows.Forms.MessageBox.Show(
        "ERROR during: " + stage + "\n\n" + ex.ToString());
}
