// #LANGUAGE# C#
// Restaura B1 somente se encontrar a LUT de identificacao esperada.

string icName = "IC 1";
string stage = "inicializacao";
int tableAddress = 0x212C;
int tableWords = 34;
int tableBytes = tableWords * 4;
byte[] calibration = new byte[tableBytes];
byte[] unity = new byte[tableBytes];

for (int i = 0; i < tableWords; i++)
{
    double detectorDbfs = (i == 0) ? -90.0 : -90.0 + 3.0 * (i - 1);
    double gainDb = -0.5 * detectorDbfs - 27.0;
    double gainLinear = System.Math.Pow(10.0, gainDb / 20.0);
    long fixed523 = (long)System.Math.Round(gainLinear * 8388608.0);

    calibration[4 * i + 0] = (byte)((fixed523 >> 24) & 0xFF);
    calibration[4 * i + 1] = (byte)((fixed523 >> 16) & 0xFF);
    calibration[4 * i + 2] = (byte)((fixed523 >> 8) & 0xFF);
    calibration[4 * i + 3] = (byte)(fixed523 & 0xFF);

    unity[4 * i + 0] = 0x00;
    unity[4 * i + 1] = 0x80;
    unity[4 * i + 2] = 0x00;
    unity[4 * i + 3] = 0x00;
}

try
{
    stage = "leitura de pre-flight em IC 1";
    byte[] before = new byte[tableBytes];
    for (int wordIndex = 0; wordIndex < tableWords; wordIndex++)
    {
        byte[] wordRead = new byte[4];
        ss.ICRegisterRead(icName, tableAddress + 4 * wordIndex, 4, ref wordRead);
        for (int byteIndex = 0; byteIndex < 4; byteIndex++)
        {
            before[4 * wordIndex + byteIndex] = wordRead[byteIndex];
        }
    }

    bool isCalibration = true;
    bool isUnity = true;
    for (int i = 0; i < tableBytes; i++)
    {
        if (before[i] != calibration[i]) isCalibration = false;
        if (before[i] != unity[i]) isUnity = false;
    }

    if (!isCalibration && !isUnity)
    {
        System.Windows.Forms.MessageBox.Show(
            "ABORT: B1 nao corresponde nem a LUT de calibracao nem a LUT unitaria.\n\n" +
            "Isso pode ser o estado parcial deixado pela transferencia longa.\n" +
            "Execute Link Compile Download; ele restaura a LUT unitaria sem depender deste script. Nenhum byte foi escrito.");
        throw new System.OperationCanceledException("Pre-flight reprovado.");
    }

    stage = "restauracao da LUT unitaria";
    for (int wordIndex = 0; wordIndex < tableWords; wordIndex++)
    {
        byte[] wordWrite = new byte[4];
        for (int byteIndex = 0; byteIndex < 4; byteIndex++)
        {
            wordWrite[byteIndex] = unity[4 * wordIndex + byteIndex];
        }

        stage = "restauracao da palavra " + wordIndex.ToString();
        ss.ICRegisterWrite(icName, tableAddress + 4 * wordIndex, 4, wordWrite);

        stage = "verificacao da palavra " + wordIndex.ToString();
        byte[] wordRead = new byte[4];
        ss.ICRegisterRead(icName, tableAddress + 4 * wordIndex, 4, ref wordRead);
        for (int byteIndex = 0; byteIndex < 4; byteIndex++)
        {
            if (wordRead[byteIndex] != wordWrite[byteIndex])
            {
                throw new System.Exception(
                    "Readback diferente no endereco 0x" +
                    (tableAddress + 4 * wordIndex + byteIndex).ToString("X4"));
            }
        }
    }

    System.Windows.Forms.MessageBox.Show(
        "PASS: B1 restaurado para ganho unitario e verificado palavra por palavra.");
}
catch (System.OperationCanceledException)
{
    // O diagnostico ja foi apresentado.
}
catch (System.Exception ex)
{
    System.Windows.Forms.MessageBox.Show(
        "ERROR durante: " + stage + "\n\n" + ex.ToString() +
        "\n\nExecute Link Compile Download antes de repetir.");
}
