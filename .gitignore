# Hardware and production firmware live in independent repositories.
/HW/
/FW/

# Local third-party checkout and Python environment.
/tools/clarity/source/
/tools/clarity/.venv/
.venv/

# Reproducible smoke-test audio and logs (generated locally).
/experiments/prescriptions/generated/inputs/
/experiments/prescriptions/generated/outputs/
/experiments/prescriptions/generated/openmha_smoke_*.log

# Local document/render output unrelated to the evaluation repository.
/output/

# High-volume REW acquisitions. Keep protocols, manifests, processed results,
# figures and reports in Git; archive raw .mdat/.txt files separately.
/tiresias-eval-sigma/rew/N1/curves/*.mdat
/tiresias-eval-sigma/rew/N1/curves/*.txt
/tiresias-eval-sigma/rew/prescription-campaign-*/raw/**/*.mdat
/tiresias-eval-sigma/rew/prescription-campaign-*/raw/**/*.txt

# The organized copy is under docs/measurements/.
/rew/

# Temporary and editor/runtime files.
/tmp/
**/__pycache__/
*.py[cod]
.DS_Store
**/.DS_Store
*.swp
*.swo
